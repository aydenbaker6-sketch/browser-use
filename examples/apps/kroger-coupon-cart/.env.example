# From https://developer.kroger.com -> My Apps -> your app
KROGER_CLIENT_ID=your-client-id
KROGER_CLIENT_SECRET=your-client-secret
# Must exactly match a Redirect URI registered on the app
KROGER_REDIRECT_URI=http://localhost:8765/callback
# kroger.com, ralphs.com, frysfood.com, kingsoopers.com, fredmeyer.com, smithsfoodanddrug.com, ...
KROGER_BANNER=kroger.com
# Optional: full path to chrome.exe / msedge.exe if it is not found automatically
# KROGER_CHROME=C:\Program Files\Google\Chrome\Application\chrome.exe
